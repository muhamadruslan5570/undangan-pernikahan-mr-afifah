            }
        }

        async function kirimKomentarUcapan() {
            const form = document.getElementById('rsvpForm');
            const namaInput = document.getElementById('nama');
            const statusInput = document.getElementById('status');
            const pesanInput = document.getElementById('pesan');
            const commentButton = form.querySelector('button[onclick="kirimKomentarUcapan()"]');

            const nama = namaInput.value.trim();
            const status = statusInput.value.trim();
            const pesan = pesanInput.value.trim();

            if (!nama || !status || !pesan) {
                alert("Nama, status kehadiran, dan ucapan wajib diisi.");
                return;
            }

            const originalButtonHtml = commentButton.innerHTML;

            commentButton.disabled = true;
            commentButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyimpan...';

            try {
                const response = await fetch(GUESTBOOK_API, {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        name: nama,
                        status: status,
                        message: pesan
                    })
                });

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.detail || "Ucapan gagal disimpan.");
                }

                await loadComments();

                pesanInput.value = '';

                alert("Ucapan berhasil dikirim dan ditampilkan di buku tamu.");

            } catch (error) {
                console.error("Gagal menyimpan komentar:", error);

                alert(
                    "Ucapan belum berhasil disimpan. Pastikan server buku tamu sedang berjalan."
                );

            } finally {
                commentButton.disabled = false;
                commentButton.innerHTML = originalButtonHtml;
            }
        }

