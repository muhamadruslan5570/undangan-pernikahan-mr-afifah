/* =========================================================
   BUTTERFLY ANIMATION - KOLOM UCAPAN
   ========================================================= */

.butterfly-animation {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9998;
    overflow: hidden;
}

.butterfly {
    position: absolute;
    bottom: 28%;
    font-size: 25px;
    opacity: 0;
    filter: drop-shadow(0 3px 5px rgba(188,108,37,.25));
    animation-fill-mode: forwards;
}

.butterfly.b1 {
    left: 38%;
    animation: butterflyFlight1 4.8s ease-out forwards;
}

.butterfly.b2 {
    left: 48%;
    font-size: 21px;
    animation: butterflyFlight2 5.4s ease-out .15s forwards;
}

.butterfly.b3 {
    left: 58%;
    font-size: 27px;
    animation: butterflyFlight3 5s ease-out .3s forwards;
}

.butterfly.b4 {
    left: 43%;
    font-size: 18px;
    animation: butterflyFlight4 4.5s ease-out .45s forwards;
}

.butterfly.b5 {
    left: 54%;
    font-size: 22px;
    animation: butterflyFlight5 5.7s ease-out .55s forwards;
}

@keyframes butterflyFlight1 {
    0% {
        transform: translate(0, 20px) scale(.25) rotate(-10deg);
        opacity: 0;
    }
    12% {
        opacity: 1;
    }
    35% {
        transform: translate(-75px, -90px) scale(1) rotate(12deg);
    }
    58% {
        transform: translate(-20px, -180px) scale(.9) rotate(-8deg);
    }
    80% {
        transform: translate(70px, -285px) scale(.75) rotate(15deg);
        opacity: .85;
    }
    100% {
        transform: translate(125px, -390px) scale(.5) rotate(-5deg);
        opacity: 0;
    }
}

@keyframes butterflyFlight2 {
    0% {
        transform: translate(0, 25px) scale(.2) rotate(8deg);
        opacity: 0;
    }
    15% {
        opacity: .95;
    }
    35% {
        transform: translate(85px, -80px) scale(1) rotate(-12deg);
    }
    60% {
        transform: translate(35px, -190px) scale(.9) rotate(10deg);
    }
    82% {
        transform: translate(-75px, -300px) scale(.7) rotate(-15deg);
        opacity: .75;
    }
    100% {
        transform: translate(-120px, -400px) scale(.45) rotate(8deg);
        opacity: 0;
    }
}

@keyframes butterflyFlight3 {
    0% {
        transform: translate(0, 20px) scale(.25) rotate(-5deg);
        opacity: 0;
    }
    14% {
        opacity: 1;
    }
    38% {
        transform: translate(70px, -105px) scale(1.05) rotate(14deg);
    }
    62% {
        transform: translate(125px, -205px) scale(.9) rotate(-10deg);
    }
    82% {
        transform: translate(55px, -315px) scale(.7) rotate(12deg);
        opacity: .7;
    }
    100% {
        transform: translate(-10px, -420px) scale(.4) rotate(-8deg);
        opacity: 0;
    }
}

@keyframes butterflyFlight4 {
    0% {
        transform: translate(0, 15px) scale(.2) rotate(5deg);
        opacity: 0;
    }
    18% {
        opacity: .9;
    }
    42% {
        transform: translate(-110px, -100px) scale(1) rotate(-14deg);
