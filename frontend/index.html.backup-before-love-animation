        /* Fungsi Membuka & Menutup Kotak Komentar */
        function bukaKotakKomentar() {
            document.getElementById('envelope-closed').classList.add('hidden');
            document.getElementById('comment-content-box').classList.remove('hidden');

            // Hentikan animasi lama jika ada
            if (window.butterflyInterval) {
                clearInterval(window.butterflyInterval);
                window.butterflyInterval = null;
            }

            const createButterflies = () => {
                const oldButterflies = document.querySelector('.butterfly-animation');
                if (oldButterflies) {
                    oldButterflies.remove();
                }

                const butterflyBox = document.createElement('div');
                butterflyBox.className = 'butterfly-animation';

                butterflyBox.innerHTML = `
                    <span class="butterfly b1">🦋</span>
                    <span class="butterfly b2">🦋</span>
                    <span class="butterfly b3">🦋</span>
                    <span class="butterfly b4">🦋</span>
                    <span class="butterfly b5">🦋</span>
                `;

                document.body.appendChild(butterflyBox);

                setTimeout(() => {
                    if (butterflyBox.parentNode) {
                        butterflyBox.remove();
                    }
                }, 6500);
            };

            // Muncul pertama kali
            createButterflies();

            // Muncul kembali terus-menerus
            window.butterflyInterval = setInterval(createButterflies, 5000);
        }

        function tutupKotakKomentar() {
            document.getElementById('comment-content-box').classList.add('hidden');
            document.getElementById('envelope-closed').classList.remove('hidden');
        }

        function toggleMusic() {
            let t = document.getElementById('background-music'),
                e = document.getElementById('music-control');
            isPlaying ? (t.pause(), e.classList.remove('playing')) : (t.play(), e.classList.add('playing'));
            isPlaying = !isPlaying;
        }

        const countDownDate = new Date("Oct 25, 2026 10:00:00").getTime(),
              x = setInterval(() => {
                  const now = new Date().getTime(),
                        dist = countDownDate - now;
                  if (dist < 0) {
                      clearInterval(x);
                      document.querySelector(".countdown").innerHTML = "<h3>Acara Sedang Berlangsung</h3>";
                  } else {
                      document.getElementById("days").innerText = Math.floor(dist / (1000 * 60 * 60 * 24));
                      document.getElementById("hours").innerText = Math.floor((dist % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                      document.getElementById("minutes").innerText = Math.floor((dist % (1000 * 60 * 60)) / (1000 * 60));
                      document.getElementById("seconds").innerText = Math.floor((dist % (1000 * 60)) / 1000);
                  }
              }, 1000);

        const GUESTBOOK_API = "http://127.0.0.1:6100/api/messages";

        async function loadComments() {
            const container = document.getElementById('commentsList');

            if (!container) return;

            container.innerHTML = `
                <div class="comment-item">
                    <p class="comment-text">Memuat ucapan...</p>
                </div>
            `;

            try {
                const response = await fetch(GUESTBOOK_API);

                if (!response.ok) {
                    throw new Error("Gagal mengambil ucapan.");
                }

                const result = await response.json();
                const comments = result.messages || [];

                if (comments.length === 0) {
                    container.innerHTML = `
                        <div class="comment-item">
                            <p class="comment-text">
                                Belum ada ucapan. Jadilah yang pertama memberikan doa untuk Ruslan & Afifah.
                            </p>
                        </div>
                    `;
                    return;
                }

                let html = '';

                comments.forEach((c) => {
                    html += `
                        <div class="comment-item">
                            <div class="comment-header">
                                <span class="comment-name">${escapeHtml(c.name)}</span>
                                <span class="comment-status">${escapeHtml(c.status)}</span>
                            </div>
                            <p class="comment-text">${escapeHtml(c.message)}</p>
                            <button class="btn-delete-comment" onclick="hapusKomentar(${c.id}, this)">
                                <i class="fa-solid fa-trash"></i> Hapus
                            </button>
                            <div style="clear: both;"></div>
                        </div>
                    `;
                });

                container.innerHTML = html;

            } catch (error) {
                console.error("Guestbook error:", error);

                container.innerHTML = `
                    <div class="comment-item">
                        <p class="comment-text">
