    <script>
        function salinRekening(elementId){
            const t = document.getElementById(elementId).innerText;
            navigator.clipboard.writeText(t).then(()=>{
                alert("Nomor rekening berhasil disalin: "+t);
            }).catch(err=>{
                console.error("Gagal menyalin: ", err);
            });
        }

        window.addEventListener('DOMContentLoaded', () => {
            const t = new URLSearchParams(window.location.search),
                  e = t.get('id'),
                  a = t.get('to'),
                  n = t => { document.getElementById('nama-tamu').innerText = t, document.getElementById('nama').value = t };
            
            if (e) {
                fetch('data/tamu.csv')
                    .then(t => t.text())
                    .then(t => {
                        const o = t.split('\n');
                        let r = "Tamu Undangan";
                        for (let t = 1; t < o.length; t++) {
                            const s = o[t].split(',');
                            if (s.length >= 2 && s[0].trim() === e) { r = s[1].trim(); break; }
                        }
                        n(r);
                    })
                    .catch(() => n("Tamu Undangan"));
            } else a ? n(decodeURIComponent(a)) : n("Tamu Undangan");

            loadTurutMengundang('data/turut-mengundang-mempelai-wanita.csv', 'list-wanita');
            loadTurutMengundang('data/turut-mengundang-mempelai-pria.csv', 'list-pria');
            loadComments();
        });

        function loadTurutMengundang(filePath, elementId) {
            fetch(filePath)
                .then(res => {
                    if (!res.ok) throw new Error('File tidak ditemukan');
                    return res.text();
                })
                .then(data => {
                    const rows = data.replace(/\r/g, '').split('\n');
                    let html = '';
                    let count = 1;
                    for (let i = 0; i < rows.length; i++) {
                        let name = rows[i].trim();
                        if (name) {
                            html += `<li>${count}. ${name}</li>`;
                            count++;
                        }
                    }
                    document.getElementById(elementId).innerHTML = html || '<li>Data kosong</li>';
                })
                .catch(err => {
                    console.error("Error loading " + filePath, err);
                    document.getElementById(elementId).innerHTML = '<li>Gagal memuat data</li>';
                });
        }

        let isPlaying = false;
        function bukaUndangan() {
            const t = document.getElementById('cover'),
                  e = document.getElementById('main-content'),
                  a = document.getElementById('background-music'),
                  n = document.getElementById('music-control');
            
            t.style.transform = 'translateY(-100%)';
            setTimeout(() => { t.style.display = 'none'; e.classList.remove('hidden'); }, 1000);
            a.play().then(() => { isPlaying = true; n.classList.add('playing'); }).catch(t => console.log("Audio dibatasi:", t));
        }

        /* Fungsi Membuka & Menutup Amplop Galeri Foto */
        function bukaAmplopGaleri() {
            document.getElementById('gallery-closed').classList.add('hidden');
            document.getElementById('gallery-content-box').classList.remove('hidden');
